(function(){
  const defaults={library:true,museum:true,school:true,market:true,business:false,welfare:false,tourism:false,park:false,landuse:true,urban:true,heritage:false};
  state.dataLimit=Number(state.dataLimit)||3000; state.subLayers=Object.assign({},defaults,state.subLayers||{});
  state.layers=Object.assign({planning:false},state.layers||{}); state.realLayers=Object.assign({buildings:[],roads:[],facilities:[],parcel:[],planning:[]},state.realLayers||{});
  const css=document.createElement('style');css.textContent='.layer-details{border:1px solid #edf1f0;border-radius:10px;padding:8px 10px;background:#fbfcfc;font-size:11px;color:#536466}.layer-details summary{cursor:pointer;font-weight:750;color:#42605d}.sub-layer-list{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.sub-layer-list label{display:flex;gap:5px;align-items:center}.data-limit;display:grid;grid-template-columns:1fr 110px;gap:8px;align-items:center;margin-top:14px;font-size:11px;color:#536466;font-weight:700}.data-limit select{border:1px solid #dfe7e8;border-radius:8px;padding:7px;background:#fff;color:#203036}';document.head.appendChild(css);
  const panel=document.querySelector('#layers .layers'),facilityInput=document.querySelector('input[data-layer="facilities"]'),parcelInput=document.querySelector('input[data-layer="parcel"]');
  if(panel&&!panel.querySelector('[data-sub-layer="library"]')){facilityInput.closest('.layer-row').insertAdjacentHTML('afterend','<details class="layer-details"><summary>주요시설 세부 레이어</summary><div class="sub-layer-list"><label><input type="checkbox" data-sub-layer="library" checked> 작은도서관</label><label><input type="checkbox" data-sub-layer="museum" checked> 박물관·미술관</label><label><input type="checkbox" data-sub-layer="school" checked> 교육·공공시설</label><label><input type="checkbox" data-sub-layer="market" checked> 전통시장</label><label><input type="checkbox" data-sub-layer="business"> 주요상권</label><label><input type="checkbox" data-sub-layer="welfare"> 복지시설</label><label><input type="checkbox" data-sub-layer="tourism"> 관광안내소</label><label><input type="checkbox" data-sub-layer="park"> 도시계획·공원</label></div></details>');parcelInput.closest('.layer-row').insertAdjacentHTML('afterend','<div class="layer-row"><div class="left"><i class="swatch" style="background:#9a6b32"></i>도시계획·법규</div><label class="switch"><input type="checkbox" data-layer="planning"><span class="slider"></span></label></div><details class="layer-details"><summary>도시계획·법규 세부 레이어</summary><div class="sub-layer-list"><label><input type="checkbox" data-sub-layer="landuse" checked> 토지이용계획</label><label><input type="checkbox" data-sub-layer="urban" checked> 도시계획시설</label><label><input type="checkbox" data-sub-layer="heritage"> 국가유산·보호구역</label></div></details>');const stat=document.querySelector('#layers h4');stat.insertAdjacentHTML('afterend','<div class="data-limit"><label for="dataLimit">레이어별 최대 수집량</label><select id="dataLimit"><option value="100">100개</option><option value="500">500개</option><option value="1000">1,000개</option><option value="3000" selected>3,000개</option><option value="10000">10,000개</option></select></div>');}
  if(!document.querySelector('#realPlanningLayer'))document.querySelector('#mapSvg').insertAdjacentHTML('beforeend','<g id="realPlanningLayer"></g>');
  const facilityCatalog=[{subKey:'library',id:'LT_P_SMALLLIBRARY',wfs:'lt_p_smalllibrary',name:'작은도서관'},{subKey:'museum',id:'LT_P_DGMUSEUMART',wfs:'lt_p_dgmuseumart',name:'박물관·미술관'},{subKey:'school',id:'LT_C_UPISUQ155',wfs:'lt_c_upisuq155',name:'교육·공공시설'},{subKey:'market',id:'LT_P_TRADSIJANG',wfs:'lt_p_tradsijang',name:'전통시장'},{subKey:'business',id:'LT_C_DGMAINBIZ',wfs:'lt_c_dgmainbiz',name:'주요상권'},{subKey:'welfare',id:'LT_P_MGPRTFB',wfs:'lt_p_mgprtfb',name:'복지시설'},{subKey:'tourism',id:'LT_P_DGTOURISTINFO',wfs:'lt_p_dgtouristinfo',name:'관광안내소'},{subKey:'park',id:'LT_C_UPISUQ153',wfs:'lt_c_upisuq153',name:'도시계획·공원'}];
  const planningCatalog=[{subKey:'landuse',id:'LT_C_LHBLPN',wfs:'lt_c_lhblpn',name:'토지이용계획'},{subKey:'urban',id:'LT_C_UPISUQ155',wfs:'lt_c_upisuq155',name:'도시계획시설'},{subKey:'heritage',id:'LT_C_UO301',wfs:'lt_c_uo301',name:'국가유산·보호구역'}];
  function selectedLayers(){const a=[];if(state.layers.buildings&&!state.realLayers.buildings.length)a.push('lt_c_bldg_info');if(state.layers.roads&&!state.realLayers.roads.length)a.push('lt_l_n3a0020000');if(state.layers.facilities&&!state.realLayers.facilities.length)facilityCatalog.filter(x=>state.subLayers[x.subKey]).forEach(x=>a.push(x.wfs));if(state.layers.planning&&!state.realLayers.planning.length)planningCatalog.filter(x=>state.subLayers[x.subKey]).forEach(x=>a.push(x.wfs));if(state.layers.parcel&&!state.realLayers.parcel.length)a.push('lt_c_landinfobasemap');return a.slice(0,4)}
  window.staticOverlayLayers=selectedLayers;
  async function queryData(spec,key){const c=analysisCenter(),b=geoBbox(c.lat,c.lon),target=Math.max(1,Number(state.dataLimit)||3000),size=Math.min(1000,target),all=[];let page=1,total=Infinity;while(page<=Math.ceil(target/size)&&all.length<target&&all.length<total){const p=new URLSearchParams({service:'data',version:'2.0',request:'GetFeature',format:'json',errorformat:'json',size:String(size),page:String(page),data:spec.id,geomFilter:`BOX(${b.minLon},${b.minLat},${b.maxLon},${b.maxLat})`,geometry:'true',attribute:'true',crs:'EPSG:4326',domain:serviceDomain()});p.set('key',key);const d=await jsonp('https://api.vworld.kr/req/data?'+p.toString()),r=d.response||{};if(r.status!=='OK')throw new Error(spec.name+': '+(r.error?.text||r.error||'조회 실패'));const fc=r.result?.featureCollection||r.result,fs=fc?.features||[];total=Number(r.record?.total||fs.length);all.push(...fs.slice(0,target-all.length));if(!fs.length||fs.length<size)break;page++;}return {features:all,total:total===Infinity?all.length:total,source:'data'};}
  async function queryWfs(spec,key){const c=analysisCenter(),b=geoBbox(c.lat,c.lon),p=new URLSearchParams({SERVICE:'WFS',REQUEST:'GetFeature',VERSION:'1.1.0',typename:spec.wfs,BBOX:`${b.minLat},${b.minLon},${b.maxLat},${b.maxLon},EPSG:4326`,srsname:'EPSG:4326',output:'text/javascript',maxfeatures:String(Math.min(1000,Math.max(1,Number(state.dataLimit)||3000))),key,domain:serviceDomain()}),d=await wfsJsonp('https://api.vworld.kr/req/wfs?'+p.toString());return {features:d.features||[],total:Number(d.totalFeatures||d.features?.length||0),source:'wfs'};}
  function paintFeature(f,kind){const fill=kind==='buildings'?'#3977a8':kind==='facilities'?'#7956a8':kind==='planning'?'#9a6b32':'#89958d',stroke=kind==='buildings'?'#245b83':kind==='facilities'?'#66418e':kind==='planning'?'#744818':'#647570',out=[];for(const part of geometryParts(f.geometry)){const pts=part.coords.map(c=>{const p=geoToSvg(Number(c[0]),Number(c[1]));return p.x+','+p.y}).join(' ');if(part.type==='point'){const p=geoToSvg(Number(part.coords[0][0]),Number(part.coords[0][1]));out.push('<circle cx="'+p.x+'" cy="'+p.y+'" r="5" fill="'+fill+'" stroke="#fff" stroke-width="1.5"/>')}else if(part.type==='line')out.push('<polyline points="'+pts+'" fill="none" stroke="'+stroke+'" stroke-width="'+(kind==='roads'?2.5:1.5)+'" opacity=".85"/>');else out.push('<polygon points="'+pts+'" fill="'+fill+'" fill-opacity=".28" stroke="'+stroke+'" stroke-width="1.2"/>')}return out.join('')}
  window.renderRealLayers=function(){const sets=[['realBuildingsLayer','buildings'],['realRoadsLayer','roads'],['realFacilitiesLayer','facilities'],['realPlanningLayer','planning'],['realParcelLayer','parcel']];for(const [id,kind] of sets){const g=document.querySelector('#'+id);if(!g)continue;const fs=(state.realLayers[kind]||[]).filter(f=>kind!=='facilities'&&kind!=='planning'||state.subLayers[f._sourceKey]!==false);g.innerHTML=fs.map(f=>paintFeature(f,kind)).join('');g.style.display=state.layers[kind]?'':'none'}const has=state.realLayerLoaded;['buildings','roads','facilities','parcel'].forEach(k=>{const g=document.querySelector('#'+k+'Layer');if(g)g.style.display=has?'none':(state.layers[k]?'':'none')});};
  window.loadVworldLayers=async function(){const key=document.querySelector('#apiKey').value.trim();if(!state.site.lat||!state.site.lon){toast('먼저 주소를 조회해 좌표를 확정하세요.');return}if(!key){toast('실제 레이어 조회에는 API 키가 필요합니다.');return}const btn=document.querySelector('#loadVworldBtn'),status=document.querySelector('#realLayerStatus');btn.disabled=true;status.textContent='VWorld 실제 레이어 조회 중…';state.realLayers={buildings:[],roads:[],facilities:[],parcel:[],planning:[]};const specs=[];if(state.layers.buildings)specs.push({key:'buildings',id:'LT_C_BLDG_INFO',wfs:'lt_c_bldg_info',name:'건축물정보'});if(state.layers.roads)specs.push({key:'roads',id:'LT_L_N3A0020000',wfs:'lt_l_n3a0020000',name:'도로중심선'});if(state.layers.facilities)facilityCatalog.filter(x=>state.subLayers[x.subKey]).forEach(x=>specs.push(Object.assign({},x,{key:'facilities'})));if(state.layers_planning&&state.realLayers_planning.length)and=1;